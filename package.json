{
  "name": "meterpulse",
  "version": "1.0.0",
  "description": "High-throughput usage-based metering and billing engine with idempotent ingestion and graduated tier rating",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest --detectOpenHandles",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "billing",
    "metering",
    "distributed-systems",
    "fintech",
    "usage-based-pricing",
    "idempotency"
  ],
  "author": "Akshay Nisang <axaynisang@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.5",
    "@types/uuid": "^9.0.2",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}